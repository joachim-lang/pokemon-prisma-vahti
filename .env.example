# Slack (valinnainen, jos käytät Telegramia)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Telegram-botti: luo @BotFatherilla, avaa botti ja /start
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Hidas täysi scan (--watch / GitHub Actions)
CHECK_INTERVAL_MINUTES=5

# Nopea ostoskorivahti (--fast / launchd), sekunteina. Alle 8 ei hyväksytä.
FAST_CHECK_SECONDS=15
