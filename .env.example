# Slack (valinnainen, jos käytät Telegramia)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Telegram-botti: luo @BotFatherilla, avaa botti ja /start
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Luotettava vahti = prosessi joka ei nuku (Fly/VPS: python scraper.py --fast).
# GitHub on varalla: ~6 h ajo + ketju. cron-job.org voi herättää repository_dispatchilla (watch).
CHECK_INTERVAL_MINUTES=5
FAST_CHECK_SECONDS=8
# 403/429 hidastaa automaattisesti, max 180 s.
