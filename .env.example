# Slack (valinnainen, jos käytät Telegramia)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Telegram-botti: luo @BotFatherilla, avaa botti ja /start
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Vahti juoksee GitHub Actionsissa. Läppäriä ei tarvita.
# Cron */5 käynnistää --fast --fast-for 270 (ostoskori ~15 s jobin ajan).
CHECK_INTERVAL_MINUTES=5
FAST_CHECK_SECONDS=15
# 403/429 hidastaa automaattisesti, max 180 s.
